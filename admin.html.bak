function renderCustomers() {
  const el = document.getElementById('customersTable');
  if (!el) return;
  el.innerHTML = customers.map((c,i)=>`<tr>
    <td>${i+1}</td><td><strong>${c.n}</strong></td><td>${c.e}</td>
    <td>${c.p}</td><td>${c.orders}</td><td>${c.spent}</td><td>${c.joined}</td>
  </tr>`).join('');
}

// ====== REVENUE CHART ======
function renderChart() {
  const data = [{m:'Jan',v:18000},{m:'Feb',v:22500},{m:'Mar',v:19800},{m:'Apr',v:28400},{m:'May',v:35200},{m:'Jun',v:41500}];
  const max = Math.max(...data.map(d=>d.v));
  const el = document.getElementById('revenueChart');
  if (!el) return;
  el.innerHTML = data.map(d=>`
    <div class="bar-wrap">
      <span class="bar-val">₨${(d.v/1000).toFixed(0)}k</span>
      <div class="bar" style="height:${Math.round(d.v/max*160)}px;background:linear-gradient(180deg,var(--primary),var(--accent));" title="${d.m}: ₨${d.v.toLocaleString()}"></div>
      <span class="bar-label">${d.m}</span>
    </div>
  `).join('');
}

// ====== NOTIFY ======
function notify(msg) {
  const el = document.getElementById('adminToast');
  document.getElementById('toastMsg').textContent = msg;
  el.classList.add('show');
  setTimeout(()=>el.classList.remove('show'), 3000);
}

// ====== INIT ======
function initAdmin() {
  renderOrders(orders);
  renderAdminProducts();
  renderCategories();
  renderCustomers();
  renderChart();
}
</script>
</body>
</html>