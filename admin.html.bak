<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>BazaarMart – Admin Panel</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
  :root {
    --primary:#e63946; --primary-dark:#c1121f;
    --secondary:#1d3557; --accent:#f4a261;
    --success:#2ec4b6; --warning:#ffd60a; --info:#457b9d;
    --bg:#f0f2f5; --white:#fff; --text:#2b2d42; --text-light:#6c757d;
    --border:#e9ecef; --sidebar:240px;
    --card-shadow:0 4px 20px rgba(0,0,0,0.07);
    --radius:12px; --radius-sm:8px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);}

  /* ====== LOGIN ====== */
  .login-screen {
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,#1d3557 0%,#457b9d 100%);
  }
  .login-card {
    background:#fff; border-radius:var(--radius); padding:48px 40px;
    width:400px; box-shadow:0 20px 60px rgba(0,0,0,0.2);
  }
  .login-logo { text-align:center; margin-bottom:28px; }
  .login-logo .icon { width:60px;height:60px;background:var(--primary);border-radius:14px;display:inline-flex;align-items:center;justify-content:center;font-size:28px;color:#fff;margin-bottom:12px; }
  .login-logo h2 { font-size:22px;font-weight:800;color:var(--secondary); }
  .login-logo p { font-size:13px;color:var(--text-light); }
  .form-group { margin-bottom:18px; }
  .form-group label { display:block;font-size:13px;font-weight:600;margin-bottom:6px;color:var(--text); }
  .form-group input {
    width:100%;padding:12px 16px;border:2px solid var(--border);border-radius:var(--radius-sm);
    font-family:'Poppins',sans-serif;font-size:14px;outline:none;transition:.2s;
  }
  .form-group input:focus { border-color:var(--primary); }
  .login-btn {
    width:100%;background:var(--primary);color:#fff;border:none;padding:14px;
    border-radius:var(--radius-sm);font-weight:700;font-size:15px;cursor:pointer;
    transition:.2s;font-family:'Poppins',sans-serif;
  }
  .login-btn:hover { background:var(--primary-dark); }
  .login-hint { text-align:center;font-size:12px;color:var(--text-light);margin-top:14px; }

  /* ====== LAYOUT ====== */
  .admin-layout { display:none; min-height:100vh; }
  .admin-layout.visible { display:flex; }

  /* ====== SIDEBAR ====== */
  .sidebar {
    width:var(--sidebar);background:var(--secondary);
    display:flex;flex-direction:column;
    position:fixed;left:0;top:0;bottom:0;z-index:100;
    overflow-y:auto;
  }
  .sidebar-brand {
    padding:22px 20px 18px;border-bottom:1px solid rgba(255,255,255,0.1);
  }
  .sidebar-brand h3 { color:#fff;font-size:18px;font-weight:800; }
  .sidebar-brand p { color:rgba(255,255,255,0.5);font-size:11px; }
  .sidebar-nav { flex:1;padding:12px 0; }
  .nav-section { padding:10px 20px 4px;font-size:10px;color:rgba(255,255,255,0.35);letter-spacing:1.5px;text-transform:uppercase; }
  .nav-item {
    display:flex;align-items:center;gap:12px;padding:11px 20px;
    color:rgba(255,255,255,0.65);font-size:13.5px;cursor:pointer;
    transition:.2s;border-left:3px solid transparent;
  }
  .nav-item:hover { background:rgba(255,255,255,0.07);color:#fff; }
  .nav-item.active { background:rgba(230,57,70,0.2);color:#fff;border-left-color:var(--primary); }
  .nav-item i { width:18px;text-align:center;font-size:14px; }
  .nav-badge { margin-left:auto;background:var(--primary);color:#fff;font-size:10px;padding:2px 7px;border-radius:10px;font-weight:700; }
  .sidebar-user {
    padding:16px 20px;border-top:1px solid rgba(255,255,255,0.1);
    display:flex;align-items:center;gap:10px;
  }
  .user-avatar { width:36px;height:36px;background:var(--primary);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px; }
  .user-info p { color:#fff;font-size:13px;font-weight:600; }
  .user-info small { color:rgba(255,255,255,0.5);font-size:11px; }
  .logout-btn { margin-left:auto;background:none;border:none;color:rgba(255,255,255,0.5);cursor:pointer;font-size:16px; }
  .logout-btn:hover { color:var(--primary); }

  /* ====== MAIN ====== */
  .main-content { margin-left:var(--sidebar);flex:1;display:flex;flex-direction:column;min-height:100vh; }
  .topbar {
    background:#fff;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;
    box-shadow:0 2px 8px rgba(0,0,0,0.05);position:sticky;top:0;z-index:50;
  }
  .topbar-left h2 { font-size:20px;font-weight:700;color:var(--secondary); }
  .topbar-left p { font-size:12px;color:var(--text-light); }
  .topbar-right { display:flex;align-items:center;gap:12px; }
  .topbar-btn { background:var(--bg);border:none;cursor:pointer;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--text);transition:.2s;position:relative; }
  .topbar-btn:hover { background:var(--primary);color:#fff; }
  .topbar-notif { position:absolute;top:-2px;right:-2px;background:var(--primary);color:#fff;font-size:9px;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700; }
  .content { padding:24px 28px; }

  /* ====== SECTIONS ====== */
  .section { display:none; }
  .section.active { display:block; }

  /* ====== STAT CARDS ====== */
  .stats-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-bottom:24px; }
  .stat-card { background:#fff;border-radius:var(--radius);padding:22px 24px;box-shadow:var(--card-shadow);display:flex;align-items:flex-start;justify-content:space-between; }
  .stat-info h4 { font-size:13px;color:var(--text-light);margin-bottom:4px; }
  .stat-info h2 { font-size:26px;font-weight:800;color:var(--text);margin-bottom:4px; }
  .stat-change { font-size:12px;font-weight:600; }
  .stat-change.up { color:var(--success); }
  .stat-change.down { color:var(--primary); }
  .stat-icon { width:52px;height:52px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:22px; }

  /* ====== CHART ====== */
  .charts-row { display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:24px; }
  .chart-card { background:#fff;border-radius:var(--radius);padding:22px;box-shadow:var(--card-shadow); }
  .chart-header { display:flex;align-items:center;justify-content:space-between;margin-bottom:20px; }
  .chart-header h3 { font-size:16px;font-weight:700; }
  .chart-select { padding:6px 12px;border:2px solid var(--border);border-radius:50px;font-family:'Poppins',sans-serif;font-size:12px;outline:none; }
  .bar-chart { display:flex;align-items:flex-end;gap:12px;height:180px; }
  .bar-wrap { flex:1;display:flex;flex-direction:column;align-items:center;gap:6px; }
  .bar { width:100%;border-radius:6px 6px 0 0;transition:.4s;cursor:pointer;min-height:8px; }
  .bar:hover { opacity:.8; }
  .bar-label { font-size:10px;color:var(--text-light);font-weight:600; }
  .bar-val { font-size:9px;color:var(--text-light); }
  .donut-chart { display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px; }
  .donut { width:140px;height:140px;position:relative; }
  .donut svg { width:100%;height:100%; }
  .donut-legend { display:flex;flex-direction:column;gap:8px;width:100%; }
  .legend-item { display:flex;align-items:center;gap:8px;font-size:12px; }
  .legend-dot { width:10px;height:10px;border-radius:50%; }

  /* ====== TABLES ====== */
  .card { background:#fff;border-radius:var(--radius);box-shadow:var(--card-shadow);overflow:hidden;margin-bottom:20px; }
  .card-header { padding:18px 22px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between; }
  .card-header h3 { font-size:16px;font-weight:700; }
  .card-body { padding:0; }
  table { width:100%;border-collapse:collapse; }
  th { background:var(--bg);padding:12px 18px;font-size:12px;font-weight:600;color:var(--text-light);text-align:left;text-transform:uppercase;letter-spacing:.5px; }
  td { padding:14px 18px;font-size:13.5px;border-bottom:1px solid var(--border); }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:#fafafa; }
  .status-badge { padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700; }
  .status-delivered { background:#d4f5f0;color:#2ec4b6; }
  .status-processing { background:#fff3cd;color:#856404; }
  .status-pending { background:#f8d7da;color:#842029; }
  .status-shipped { background:#cfe2ff;color:#084298; }
  .action-btn { background:var(--bg);border:none;cursor:pointer;width:32px;height:32px;border-radius:50%;font-size:13px;margin:0 2px;transition:.2s; }
  .action-btn:hover { background:var(--primary);color:#fff; }

  /* ====== FORMS ====== */
  .form-grid { display:grid;grid-template-columns:1fr 1fr;gap:18px; }
  .form-group-admin { margin-bottom:18px; }
  .form-group-admin label { display:block;font-size:13px;font-weight:600;margin-bottom:6px;color:var(--text); }
  .form-group-admin input,
  .form-group-admin select,
  .form-group-admin textarea {
    width:100%;padding:11px 14px;border:2px solid var(--border);border-radius:var(--radius-sm);
    font-family:'Poppins',sans-serif;font-size:14px;outline:none;transition:.2s;
    background:#fff;
  }
  .form-group-admin input:focus,
  .form-group-admin select:focus,
  .form-group-admin textarea:focus { border-color:var(--primary); }
  .form-group-admin textarea { resize:vertical;min-height:100px; }
  .btn-save { background:var(--primary);color:#fff;border:none;padding:12px 28px;border-radius:var(--radius-sm);font-weight:700;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:.2s;font-family:'Poppins',sans-serif; }
  .btn-save:hover { background:var(--primary-dark); }
  .btn-sec { background:var(--bg);color:var(--text);border:2px solid var(--border);padding:12px 24px;border-radius:var(--radius-sm);font-weight:600;font-size:14px;cursor:pointer;display:inline-flex;align-items:center;gap:8px;transition:.2s;font-family:'Poppins',sans-serif; }
  .btn-sec:hover { border-color:var(--primary);color:var(--primary); }

  /* ====== PRODUCT MANAGE ====== */
  .prod-manage-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:20px; }
  .prod-manage-card { background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--card-shadow); }
  .prod-manage-img { height:130px;background:linear-gradient(135deg,#f0f0f0,#e0e0e0);display:flex;align-items:center;justify-content:center;font-size:52px; }
  .prod-manage-info { padding:14px; }
  .prod-manage-info h4 { font-size:13px;font-weight:700;margin-bottom:4px;line-height:1.4; }
  .prod-manage-info p { font-size:12px;color:var(--text-light);margin-bottom:8px; }
  .prod-manage-actions { display:flex;gap:8px; }
  .edit-btn { flex:1;background:var(--info);color:#fff;border:none;padding:7px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;font-family:'Poppins',sans-serif; }
  .del-btn { flex:1;background:var(--primary);color:#fff;border:none;padding:7px;border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;font-family:'Poppins',sans-serif; }

  /* ====== CATEGORY MANAGE ====== */
  .cat-manage-grid { display:grid;grid-template-columns:repeat(4,1fr);gap:18px; }
  .cat-manage-card { background:#fff;border-radius:var(--radius);padding:22px;box-shadow:var(--card-shadow);text-align:center;cursor:pointer;transition:.2s;border:2px solid transparent; }
  .cat-manage-card:hover { border-color:var(--primary);transform:translateY(-2px); }
  .cat-manage-icon { font-size:36px;margin-bottom:10px; }
  .cat-manage-card h4 { font-size:14px;font-weight:700;margin-bottom:4px; }
  .cat-manage-card p { font-size:12px;color:var(--text-light);margin-bottom:14px; }
  .cat-actions { display:flex;gap:8px;justify-content:center; }

  /* ====== NOTIFICATION ====== */
  .notif-toast {
    position:fixed;bottom:24px;right:24px;background:var(--secondary);color:#fff;
    padding:14px 20px;border-radius:var(--radius-sm);display:flex;align-items:center;gap:10px;
    font-size:14px;font-weight:500;transform:translateY(100px);opacity:0;transition:.35s;z-index:9999;
    box-shadow:0 4px 20px rgba(0,0,0,0.2);
  }
  .notif-toast.show { transform:translateY(0);opacity:1; }
  .notif-toast i { color:var(--accent);font-size:18px; }

  /* ====== OVERVIEW MINI CARDS ====== */
  .mini-grid { display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px; }
  .mini-card { background:#fff;border-radius:var(--radius-sm);padding:18px;box-shadow:var(--card-shadow);display:flex;align-items:center;gap:14px; }
  .mini-icon { width:44px;height:44px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:18px; }
  .mini-info h4 { font-size:18px;font-weight:800;color:var(--text); }
  .mini-info p { font-size:12px;color:var(--text-light); }

  @media(max-width:1024px){
    .stats-grid { grid-template-columns:repeat(2,1fr); }
    .charts-row { grid-template-columns:1fr; }
    .prod-manage-grid { grid-template-columns:repeat(3,1fr); }
  }
</style>
</head>
<body>

<!-- ====== LOGIN SCREEN ====== -->
<div class="login-screen" id="loginScreen">
  <div class="login-card">
    <div class="login-logo">
      <div class="icon"><i class="fas fa-user-shield"></i></div>
      <h2>BazaarMart Admin</h2>
      <p>Sign in to manage your store</p>
    </div>
    <div class="form-group">
      <label>Username</label>
      <input type="text" id="loginUser" placeholder="admin" value="admin"/>
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" id="loginPass" placeholder="••••••••" value="admin123"/>
    </div>
    <button class="login-btn" onclick="doLogin()"><i class="fas fa-sign-in-alt"></i> Sign In to Admin</button>
    <p class="login-hint">Demo: admin / admin123 &nbsp;|&nbsp; <a href="index.html" style="color:var(--primary)">← Back to Store</a></p>
  </div>
</div>

<!-- ====== ADMIN LAYOUT ====== -->
<div class="admin-layout" id="adminLayout">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <h3>🛒 BazaarMart</h3>
      <p>Admin Dashboard</p>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section">Main</div>
      <div class="nav-item active" onclick="goTo('dashboard',this)"><i class="fas fa-tachometer-alt"></i> Dashboard</div>
      <div class="nav-item" onclick="goTo('orders',this)"><i class="fas fa-shopping-bag"></i> Orders <span class="nav-badge">12</span></div>
      <div class="nav-section">Catalog</div>
      <div class="nav-item" onclick="goTo('products',this)"><i class="fas fa-box"></i> Products</div>
      <div class="nav-item" onclick="goTo('add-product',this)"><i class="fas fa-plus-circle"></i> Add Product</div>
      <div class="nav-item" onclick="goTo('categories',this)"><i class="fas fa-th-large"></i> Categories</div>
      <div class="nav-section">Business</div>
      <div class="nav-item" onclick="goTo('customers',this)"><i class="fas fa-users"></i> Customers</div>
      <div class="nav-item" onclick="goTo('analytics',this)"><i class="fas fa-chart-line"></i> Analytics</div>
      <div class="nav-item" onclick="goTo('settings',this)"><i class="fas fa-cog"></i> Settings</div>
    </nav>
    <div class="sidebar-user">
      <div class="user-avatar">A</div>
      <div class="user-info"><p>Admin</p><small>Super Admin</small></div>
      <button class="logout-btn" onclick="logout()" title="Logout"><i class="fas fa-sign-out-alt"></i></button>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="main-content">
    <div class="topbar">
      <div class="topbar-left">
        <h2 id="pageTitle">Dashboard</h2>
        <p id="pageSubtitle">Welcome back, Admin 👋</p>
      </div>
      <div class="topbar-right">
        <button class="topbar-btn"><i class="fas fa-search"></i></button>
        <button class="topbar-btn"><i class="fas fa-bell"></i><span class="topbar-notif">3</span></button>
        <button class="topbar-btn" onclick="logout()"><i class="fas fa-sign-out-alt"></i></button>
        <a href="index.html" class="topbar-btn" title="View Store"><i class="fas fa-external-link-alt"></i></a>
      </div>
    </div>

    <div class="content">

      <!-- ===== DASHBOARD ===== -->
      <div class="section active" id="sec-dashboard">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-info">
              <h4>Total Revenue</h4>
              <h2>₨1,24,580</h2>
              <span class="stat-change up"><i class="fas fa-arrow-up"></i> +12.5% this month</span>
            </div>
            <div class="stat-icon" style="background:#fff0f3;color:var(--primary)"><i class="fas fa-rupee-sign"></i></div>
          </div>
          <div class="stat-card">
            <div class="stat-info">
              <h4>Total Orders</h4>
              <h2>348</h2>
              <span class="stat-change up"><i class="fas fa-arrow-up"></i> +8.2% this month</span>
            </div>
            <div class="stat-icon" style="background:#e8fdf5;color:var(--success)"><i class="fas fa-shopping-bag"></i></div>
          </div>
          <div class="stat-card">
            <div class="stat-info">
              <h4>Total Customers</h4>
              <h2>1,204</h2>
              <span class="stat-change up"><i class="fas fa-arrow-up"></i> +22 new this week</span>
            </div>
            <div class="stat-icon" style="background:#e8f4fd;color:var(--info)"><i class="fas fa-users"></i></div>
          </div>
          <div class="stat-card">
            <div class="stat-info">
              <h4>Total Products</h4>
              <h2 id="totalProds">36</h2>
              <span class="stat-change up">Across 7 categories</span>
            </div>
            <div class="stat-icon" style="background:#fff8e1;color:#f4a261"><i class="fas fa-box"></i></div>
          </div>
        </div>

        <div class="charts-row">
          <div class="chart-card">
            <div class="chart-header">
              <h3>Monthly Revenue</h3>
              <select class="chart-select"><option>Last 6 Months</option><option>Last Year</option></select>
            </div>
            <div class="bar-chart" id="revenueChart"></div>
          </div>
          <div class="chart-card">
            <div class="chart-header"><h3>Sales by Category</h3></div>
            <div class="donut-chart">
              <div class="donut">
                <svg viewBox="0 0 100 100">
                  <circle cx="50" cy="50" r="40" fill="none" stroke="#f0f2f5" stroke-width="16"/>
                  <circle cx="50" cy="50" r="40" fill="none" stroke="#e63946" stroke-width="16" stroke-dasharray="75 176" stroke-dashoffset="-31" transform="rotate(-90 50 50)"/>
                  <circle cx="50" cy="50" r="40" fill="none" stroke="#f4a261" stroke-width="16" stroke-dasharray="44 207" stroke-dashoffset="-106" transform="rotate(-90 50 50)"/>
                  <circle cx="50" cy="50" r="40" fill="none" stroke="#2ec4b6" stroke-width="16" stroke-dasharray="38 213" stroke-dashoffset="-150" transform="rotate(-90 50 50)"/>
                  <circle cx="50" cy="50" r="40" fill="none" stroke="#457b9d" stroke-width="16" stroke-dasharray="30 221" stroke-dashoffset="-188" transform="rotate(-90 50 50)"/>
                  <text x="50" y="54" text-anchor="middle" font-size="10" font-weight="bold" fill="#1d3557">Sales</text>
                </svg>
              </div>
              <div class="donut-legend">
                <div class="legend-item"><div class="legend-dot" style="background:#e63946"></div><span>Clothing 30%</span></div>
                <div class="legend-item"><div class="legend-dot" style="background:#f4a261"></div><span>Beauty 22%</span></div>
                <div class="legend-item"><div class="legend-dot" style="background:#2ec4b6"></div><span>Kitchen 19%</span></div>
                <div class="legend-item"><div class="legend-dot" style="background:#457b9d"></div><span>Mobile 15%</span></div>
                <div class="legend-item"><div class="legend-dot" style="background:#ffd60a"></div><span>Others 14%</span></div>
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <h3>Recent Orders</h3>
            <button class="btn-sec" onclick="goTo('orders',null)" style="padding:8px 16px;font-size:12px">View All</button>
          </div>
          <div class="card-body" id="recentOrdersTable"></div>
        </div>
      </div>

      <!-- ===== ORDERS ===== -->
      <div class="section" id="sec-orders">
        <div class="mini-grid">
          <div class="mini-card"><div class="mini-icon" style="background:#d4f5f0;color:var(--success)"><i class="fas fa-check-circle"></i></div><div class="mini-info"><h4>128</h4><p>Delivered</p></div></div>
          <div class="mini-card"><div class="mini-icon" style="background:#cfe2ff;color:#084298"><i class="fas fa-shipping-fast"></i></div><div class="mini-info"><h4>56</h4><p>Shipped</p></div></div>
          <div class="mini-card"><div class="mini-icon" style="background:#f8d7da;color:#842029"><i class="fas fa-clock"></i></div><div class="mini-info"><h4>12</h4><p>Pending</p></div></div>
        </div>
        <div class="card">
          <div class="card-header">
            <h3>All Orders</h3>
            <input type="text" placeholder="Search orders…" style="padding:8px 14px;border:2px solid var(--border);border-radius:50px;font-family:'Poppins',sans-serif;font-size:13px;outline:none;width:240px;" oninput="filterOrders(this.value)"/>
          </div>
          <div class="card-body" id="allOrdersTable"></div>
        </div>
      </div>

      <!-- ===== PRODUCTS ===== -->
      <div class="section" id="sec-products">
        <div class="card" style="margin-bottom:0">
          <div class="card-header">
            <h3>All Products (<span id="prodCount">36</span>)</h3>
            <button class="btn-save" onclick="goTo('add-product',null)"><i class="fas fa-plus"></i> Add New Product</button>
          </div>
        </div>
        <div class="prod-manage-grid" id="adminProductGrid"></div>
      </div>

      <!-- ===== ADD PRODUCT ===== -->
      <div class="section" id="sec-add-product">
        <div class="card">
          <div class="card-header"><h3>Add New Product</h3></div>
          <div style="padding:24px">
            <div class="form-grid">
              <div class="form-group-admin">
                <label>Product Name *</label>
                <input type="text" id="pName" placeholder="Enter product name"/>
              </div>
              <div class="form-group-admin">
                <label>Category *</label>
                <select id="pCat">
                  <option value="">Select category</option>
                  <option value="home-decor">Home Decor</option>
                  <option value="beauty">Beauty</option>
                  <option value="mobile">Mobile Accessories</option>
                  <option value="kitchen">Kitchen Accessories</option>
                  <option value="clothing">Clothing</option>
                  <option value="footwear">Footwear</option>
                </select>
              </div>
              <div class="form-group-admin">
                <label>Price (₨) *</label>
                <input type="number" id="pPrice" placeholder="e.g. 1999"/>
              </div>
              <div class="form-group-admin">
                <label>Old Price / MRP (₨)</label>
                <input type="number" id="pOldPrice" placeholder="e.g. 3999"/>
              </div>
              <div class="form-group-admin">
                <label>Product Emoji (icon)</label>
                <input type="text" id="pEmoji" placeholder="e.g. 🛋️"/>
              </div>
              <div class="form-group-admin">
                <label>Badge</label>
                <select id="pBadge">
                  <option value="">None</option>
                  <option value="Sale">Sale</option>
                  <option value="New">New</option>
                  <option value="Hot">Hot</option>
                  <option value="Best">Best Seller</option>
                </select>
              </div>
              <div class="form-group-admin" style="grid-column:1/-1">
                <label>Description *</label>
                <textarea id="pDesc" placeholder="Write a clear product description…"></textarea>
              </div>
              <div class="form-group-admin">
                <label>Stock Quantity</label>
                <input type="number" id="pStock" placeholder="e.g. 50"/>
              </div>
              <div class="form-group-admin">
                <label>Rating (1–5)</label>
                <input type="number" id="pRating" min="1" max="5" step="0.1" placeholder="e.g. 4.5"/>
              </div>
            </div>
            <div style="display:flex;gap:12px;margin-top:8px">
              <button class="btn-save" onclick="saveProduct()"><i class="fas fa-save"></i> Save Product</button>
              <button class="btn-sec" onclick="resetForm()"><i class="fas fa-undo"></i> Reset</button>
            </div>
            <div id="formMsg" style="margin-top:14px;font-size:13px;color:var(--success);display:none"></div>
          </div>
        </div>
      </div>

      <!-- ===== CATEGORIES ===== -->
      <div class="section" id="sec-categories">
        <div class="cat-manage-grid" id="catManageGrid"></div>
        <div class="card" style="margin-top:20px">
          <div class="card-header"><h3>Add New Category</h3></div>
          <div style="padding:24px">
            <div class="form-grid">
              <div class="form-group-admin">
                <label>Category Name</label>
                <input type="text" id="newCatName" placeholder="e.g. Electronics"/>
              </div>
              <div class="form-group-admin">
                <label>Category Emoji</label>
                <input type="text" id="newCatEmoji" placeholder="e.g. 💻"/>
              </div>
              <div class="form-group-admin" style="grid-column:1/-1">
                <label>Description</label>
                <input type="text" id="newCatDesc" placeholder="Short description"/>
              </div>
            </div>
            <button class="btn-save" onclick="addCategory()"><i class="fas fa-plus"></i> Add Category</button>
          </div>
        </div>
      </div>

      <!-- ===== CUSTOMERS ===== -->
      <div class="section" id="sec-customers">
        <div class="card">
          <div class="card-header"><h3>Customer List</h3></div>
          <div class="card-body">
            <table>
              <thead><tr><th>#</th><th>Name</th><th>Email</th><th>Phone</th><th>Orders</th><th>Total Spent</th><th>Joined</th></tr></thead>
              <tbody id="customersTable"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ===== ANALYTICS ===== -->
      <div class="section" id="sec-analytics">
        <div class="stats-grid">
          <div class="stat-card"><div class="stat-info"><h4>Conversion Rate</h4><h2>3.8%</h2><span class="stat-change up">+0.5% this week</span></div><div class="stat-icon" style="background:#e8fdf5;color:var(--success)"><i class="fas fa-percent"></i></div></div>
          <div class="stat-card"><div class="stat-info"><h4>Avg. Order Value</h4><h2>₨3,450</h2><span class="stat-change up">+₨210 this month</span></div><div class="stat-icon" style="background:#fff0f3;color:var(--primary)"><i class="fas fa-receipt"></i></div></div>
          <div class="stat-card"><div class="stat-info"><h4>Cart Abandonment</h4><h2>68%</h2><span class="stat-change down"><i class="fas fa-arrow-down"></i> -3% improved</span></div><div class="stat-icon" style="background:#fff8e1;color:#f4a261"><i class="fas fa-shopping-cart"></i></div></div>
          <div class="stat-card"><div class="stat-info"><h4>Return Rate</h4><h2>4.2%</h2><span class="stat-change up">Low — excellent</span></div><div class="stat-icon" style="background:#e8f4fd;color:var(--info)"><i class="fas fa-undo"></i></div></div>
        </div>
        <div class="card">
          <div class="card-header"><h3>Top Selling Products</h3></div>
          <div class="card-body">
            <table>
              <thead><tr><th>Product</th><th>Category</th><th>Units Sold</th><th>Revenue</th><th>Stock</th></tr></thead>
              <tbody>
                <tr><td>Vitamin C Face Serum</td><td>Beauty</td><td>412</td><td>₨61,788</td><td><span class="status-badge status-delivered">In Stock</span></td></tr>
                <tr><td>Bluetooth Earbuds</td><td>Mobile</td><td>189</td><td>₨75,611</td><td><span class="status-badge status-delivered">In Stock</span></td></tr>
                <tr><td>Air Fryer 5L</td><td>Kitchen</td><td>156</td><td>₨1,40,244</td><td><span class="status-badge status-processing">Low Stock</span></td></tr>
                <tr><td>Oversized Hoodie</td><td>Clothing</td><td>342</td><td>₨85,458</td><td><span class="status-badge status-delivered">In Stock</span></td></tr>
                <tr><td>Chunky Sneakers</td><td>Footwear</td><td>213</td><td>₨1,06,487</td><td><span class="status-badge status-pending">Low Stock</span></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ===== SETTINGS ===== -->
      <div class="section" id="sec-settings">
        <div class="card">
          <div class="card-header"><h3>Store Settings</h3></div>
          <div style="padding:24px">
            <div class="form-grid">
              <div class="form-group-admin"><label>Store Name</label><input type="text" value="BazaarMart"/></div>
              <div class="form-group-admin"><label>Store Email</label><input type="text" value="info@bazaarmart.pk"/></div>
              <div class="form-group-admin"><label>Phone Number</label><input type="text" value="+92 300 1234567"/></div>
              <div class="form-group-admin"><label>WhatsApp</label><input type="text" value="+92 300 1234567"/></div>
              <div class="form-group-admin"><label>Currency</label><select><option>PKR (₨)</option><option>USD ($)</option></select></div>
              <div class="form-group-admin"><label>Free Delivery Threshold (₨)</label><input type="number" value="2000"/></div>
              <div class="form-group-admin" style="grid-column:1/-1"><label>Store Address</label><input type="text" value="Karachi, Pakistan"/></div>
              <div class="form-group-admin"><label>Admin Username</label><input type="text" value="admin"/></div>
              <div class="form-group-admin"><label>Admin Password</label><input type="password" value="admin123"/></div>
            </div>
            <button class="btn-save" onclick="notify('✅ Settings saved successfully!')"><i class="fas fa-save"></i> Save Settings</button>
          </div>
        </div>
      </div>

    </div><!-- /content -->
  </div><!-- /main-content -->
</div><!-- /admin-layout -->

<!-- TOAST -->
<div class="notif-toast" id="adminToast"><i class="fas fa-check-circle"></i><span id="toastMsg"></span></div>

<script>
// ====== AUTH ======
function doLogin() {
  const u = document.getElementById('loginUser').value;
  const p = document.getElementById('loginPass').value;
  if (u==='admin' && p==='admin123') {
    document.getElementById('loginScreen').style.display='none';
    document.getElementById('adminLayout').classList.add('visible');
    initAdmin();
  } else {
    alert('Invalid credentials! Use admin / admin123');
  }
}
function logout() {
  document.getElementById('adminLayout').classList.remove('visible');
  document.getElementById('loginScreen').style.display='flex';
}
document.getElementById('loginPass').addEventListener('keydown',e=>{ if(e.key==='Enter') doLogin(); });

// ====== NAV ======
const pageTitles = {
  dashboard:['Dashboard','Welcome back, Admin 👋'],
  orders:['Orders','Manage & track all orders'],
  products:['Products','All your listed products'],
  'add-product':['Add Product','List a new product on the store'],
  categories:['Categories','Manage store categories'],
  customers:['Customers','View all registered customers'],
  analytics:['Analytics','Sales & performance insights'],
  settings:['Settings','Configure your store'],
};
function goTo(id, el) {
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.getElementById('sec-'+id).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  if (el) el.classList.add('active');
  else { document.querySelectorAll('.nav-item').forEach(n=>{ if(n.textContent.toLowerCase().includes(id.replace('-',' '))) n.classList.add('active'); }); }
  const [title,sub] = pageTitles[id]||['Page',''];
  document.getElementById('pageTitle').textContent = title;
  document.getElementById('pageSubtitle').textContent = sub;
}

// ====== PRODUCTS DATA ======
const products = [
  {id:1,name:"Aesthetic Wall Clock",cat:"home-decor",emoji:"🕐",price:1899,badge:"Sale"},
  {id:2,name:"Macramé Wall Hanging",cat:"home-decor",emoji:"🎨",price:1299,badge:"New"},
