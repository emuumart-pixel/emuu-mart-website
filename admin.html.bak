let adminProducts = [...products];

// ====== ORDERS ======
const orders = [
  {id:'#ORD-1042',customer:'Fatima Ahmed',product:'Vitamin C Serum × 2',total:'₨2,998',status:'delivered',date:'Jun 25, 2026'},
  {id:'#ORD-1041',customer:'Ali Hassan',product:'Air Fryer 5L × 1',total:'₨8,999',status:'shipped',date:'Jun 24, 2026'},
  {id:'#ORD-1040',customer:'Sara Khan',product:'Chunky Sneakers × 1',total:'₨4,999',status:'processing',date:'Jun 24, 2026'},
  {id:'#ORD-1039',customer:'Usman Tariq',product:'Bluetooth Earbuds × 1',total:'₨3,999',status:'delivered',date:'Jun 23, 2026'},
  {id:'#ORD-1038',customer:'Ayesha Malik',product:'Oversized Hoodie × 2',total:'₨4,998',status:'pending',date:'Jun 23, 2026'},
  {id:'#ORD-1037',customer:'Bilal Chaudhry',product:'Retinol Night Cream × 1',total:'₨2,299',status:'shipped',date:'Jun 22, 2026'},
  {id:'#ORD-1036',customer:'Zara Sheikh',product:'Puffer Jacket × 1',total:'₨5,499',status:'delivered',date:'Jun 22, 2026'},
  {id:'#ORD-1035',customer:'Hamza Qureshi',product:'Coffee Grinder × 1',total:'₨4,500',status:'processing',date:'Jun 21, 2026'},
  {id:'#ORD-1034',customer:'Nadia Javed',product:'Matte Lipstick Set × 1',total:'₨1,650',status:'delivered',date:'Jun 21, 2026'},
  {id:'#ORD-1033',customer:'Tariq Mahmood',product:'Oxford Shoes × 1',total:'₨7,999',status:'pending',date:'Jun 20, 2026'},
  {id:'#ORD-1032',customer:'Mariam Siddiqui',product:'Glass Containers × 1',total:'₨2,499',status:'shipped',date:'Jun 20, 2026'},
  {id:'#ORD-1031',customer:'Imran Baig',product:'Wall Clock × 2',total:'₨3,798',status:'delivered',date:'Jun 19, 2026'},
];

function orderRow(o) {
  const sc = {delivered:'status-delivered',processing:'status-processing',pending:'status-pending',shipped:'status-shipped'};
  return `<tr>
    <td><strong>${o.id}</strong></td>
    <td>${o.customer}</td>
    <td>${o.product}</td>
    <td><strong>${o.total}</strong></td>
    <td><span class="status-badge ${sc[o.status]}">${o.status.charAt(0).toUpperCase()+o.status.slice(1)}</span></td>
    <td>${o.date}</td>
    <td>
      <button class="action-btn" title="View"><i class="fas fa-eye"></i></button>
      <button class="action-btn" title="Edit"><i class="fas fa-edit"></i></button>
    </td>
  </tr>`;
}

function renderOrders(list) {
  const html = `<table><thead><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Total</th><th>Status</th><th>Date</th><th>Action</th></tr></thead><tbody>${list.map(orderRow).join('')}</tbody></table>`;
  const roc = document.getElementById('recentOrdersTable');
  const aoc = document.getElementById('allOrdersTable');
  if (roc) roc.innerHTML = `<table><thead><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody>${orders.slice(0,5).map(o=>orderRow(o).replace('<td><button','<td style="display:none"><button')).join('')}</tbody></table>`;
  if (aoc) aoc.innerHTML = html;
}

function filterOrders(q) {
  const filtered = orders.filter(o=>o.customer.toLowerCase().includes(q.toLowerCase())||o.id.toLowerCase().includes(q.toLowerCase())||o.product.toLowerCase().includes(q.toLowerCase()));
  document.getElementById('allOrdersTable').innerHTML = `<table><thead><tr><th>Order ID</th><th>Customer</th><th>Product</th><th>Total</th><th>Status</th><th>Date</th><th>Action</th></tr></thead><tbody>${filtered.map(orderRow).join('')}</tbody></table>`;
}

// ====== PRODUCTS ADMIN ======
function renderAdminProducts() {
  const el = document.getElementById('adminProductGrid');
  if (!el) return;
  el.innerHTML = adminProducts.map(p=>`
    <div class="prod-manage-card">
      <div class="prod-manage-img">${p.emoji}</div>
      <div class="prod-manage-info">
        <h4>${p.name}</h4>
        <p>${p.cat.replace(/-/g,' ')} · ₨${p.price.toLocaleString()}</p>
        <div class="prod-manage-actions">
          <button class="edit-btn" onclick="notify('✏️ Edit feature — connect to backend!')"><i class="fas fa-edit"></i> Edit</button>
          <button class="del-btn" onclick="deleteProduct(${p.id})"><i class="fas fa-trash"></i> Delete</button>
        </div>
      </div>
    </div>
  `).join('');
  document.getElementById('prodCount').textContent = adminProducts.length;
  document.getElementById('totalProds').textContent = adminProducts.length;
}

function deleteProduct(id) {
  if (confirm('Delete this product?')) {
    adminProducts = adminProducts.filter(p=>p.id!==id);
    renderAdminProducts();
    notify('🗑️ Product deleted');
  }
}

function saveProduct() {
  const name = document.getElementById('pName').value.trim();
  const cat = document.getElementById('pCat').value;
  const price = parseInt(document.getElementById('pPrice').value);
  if (!name||!cat||!price) { document.getElementById('formMsg').textContent='⚠️ Please fill in all required fields.'; document.getElementById('formMsg').style.display='block'; document.getElementById('formMsg').style.color='var(--primary)'; return; }
  const newProd = {
    id: Date.now(),
    name,cat,price,
    oldPrice: parseInt(document.getElementById('pOldPrice').value)||null,
    emoji: document.getElementById('pEmoji').value||'📦',
    badge: document.getElementById('pBadge').value||null,
    desc: document.getElementById('pDesc').value,
    rating: parseFloat(document.getElementById('pRating').value)||4.0,
    reviews: 0,
  };
  adminProducts.unshift(newProd);
  renderAdminProducts();
  document.getElementById('formMsg').textContent='✅ Product added successfully!';
  document.getElementById('formMsg').style.display='block';
  document.getElementById('formMsg').style.color='var(--success)';
  notify('✅ Product added to store!');
  resetForm();
}

function resetForm() {
  ['pName','pCat','pPrice','pOldPrice','pEmoji','pBadge','pDesc','pStock','pRating'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
}

// ====== CATEGORIES ======
const cats = [
  {name:'Home Decor',emoji:'🛋️',count:6,key:'home-decor'},
  {name:'Beauty Items',emoji:'💄',count:6,key:'beauty'},
  {name:'Mobile Accessories',emoji:'📱',count:6,key:'mobile'},
  {name:'Kitchen Accessories',emoji:'🍳',count:6,key:'kitchen'},
  {name:'Clothing',emoji:'👕',count:6,key:'clothing'},
  {name:'Footwear',emoji:'👟',count:6,key:'footwear'},
];
let allCats = [...cats];

function renderCategories() {
  const el = document.getElementById('catManageGrid');
  if (!el) return;
  el.innerHTML = allCats.map((c,i)=>`
    <div class="cat-manage-card">
      <div class="cat-manage-icon">${c.emoji}</div>
      <h4>${c.name}</h4>
      <p>${c.count} products</p>
      <div class="cat-actions">
        <button class="edit-btn" onclick="notify('✏️ Edit category — connect to backend!')"><i class="fas fa-edit"></i></button>
        <button class="del-btn" onclick="deleteCat(${i})"><i class="fas fa-trash"></i></button>
      </div>
    </div>
  `).join('');
}

function deleteCat(i) {
  if(confirm('Delete this category?')) { allCats.splice(i,1); renderCategories(); notify('🗑️ Category removed'); }
}

function addCategory() {
  const name = document.getElementById('newCatName').value.trim();
  const emoji = document.getElementById('newCatEmoji').value||'📁';
  if (!name) return;
  allCats.push({name,emoji,count:0,key:name.toLowerCase().replace(/\s/g,'-')});
  renderCategories();
  document.getElementById('newCatName').value='';
  document.getElementById('newCatEmoji').value='';
  document.getElementById('newCatDesc').value='';
  notify('✅ Category added!');
}

// ====== CUSTOMERS ======
