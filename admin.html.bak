  {id:17,name:"Car Phone Holder",cat:"mobile",emoji:"🚗",price:899,badge:"Sale"},
  {id:18,name:"USB-C Cable 2M",cat:"mobile",emoji:"🔌",price:599,badge:"New"},
  {id:19,name:"Air Fryer 5L",cat:"kitchen",emoji:"🍟",price:8999,badge:"Best"},
  {id:20,name:"Knife Set 6pc",cat:"kitchen",emoji:"🔪",price:2999,badge:"Sale"},
  {id:21,name:"Silicone Utensil Set",cat:"kitchen",emoji:"🥄",price:1299,badge:"New"},
  {id:22,name:"Glass Storage Containers",cat:"kitchen",emoji:"🥡",price:2499,badge:"Hot"},
  {id:23,name:"Electric Coffee Grinder",cat:"kitchen",emoji:"☕",price:4500,badge:"Sale"},
  {id:24,name:"Non-Stick Fry Pan",cat:"kitchen",emoji:"🍳",price:1799,badge:"New"},
  {id:25,name:"Oversized Graphic Hoodie",cat:"clothing",emoji:"👕",price:2499,badge:"Hot"},
  {id:26,name:"Cargo Pants Multi Pocket",cat:"clothing",emoji:"👖",price:3299,badge:"New"},
  {id:27,name:"Summer Floral Dress",cat:"clothing",emoji:"👗",price:2199,badge:"Sale"},
  {id:28,name:"Cotton T-Shirt Pack 3pc",cat:"clothing",emoji:"🧵",price:1499,badge:"Best"},
  {id:29,name:"Lightweight Puffer Jacket",cat:"clothing",emoji:"🧥",price:5499,badge:"New"},
  {id:30,name:"Denim Jacket Washed",cat:"clothing",emoji:"🪡",price:4299,badge:"Sale"},
  {id:31,name:"Chunky Platform Sneakers",cat:"footwear",emoji:"👟",price:4999,badge:"Hot"},
  {id:32,name:"Leather Loafers Slip-On",cat:"footwear",emoji:"🥿",price:5499,badge:"Best"},
  {id:33,name:"Sports Running Shoes",cat:"footwear",emoji:"🏃",price:3999,badge:"Sale"},
  {id:34,name:"Ankle Boots Block Heel",cat:"footwear",emoji:"👢",price:6299,badge:"New"},
