// ====== STATE ======
let cart = JSON.parse(localStorage.getItem('bm_cart')||'[]');
let currentCat = 'all';
let currentModal = null;
let priceFilter = 'all';
let sortMode = 'default';

// ====== RENDER ======
function renderCard(p) {
  const disc = p.oldPrice ? Math.round((1-p.price/p.oldPrice)*100) : 0;
  const stars = '★'.repeat(Math.floor(p.rating))+'☆'.repeat(5-Math.floor(p.rating));
  return `<div class="product-card" onclick="openModal(${p.id})">
    <div class="product-img">
      <span>${p.emoji}</span>
      ${p.badge?`<span class="product-badge ${p.badge==='New'?'new':p.badge==='Hot'?'hot':''}">${p.badge}</span>`:''}
      <button class="product-wishlist" onclick="event.stopPropagation();wishItem(this)"><i class="far fa-heart"></i></button>
    </div>
    <div class="product-info">
      <p class="product-cat">${p.cat.replace(/-/g,' ')}</p>
      <p class="product-name">${p.name}</p>
      <div class="product-rating"><span class="stars">${stars}</span><span class="rating-count">(${p.reviews})</span></div>
      <div class="product-price">
        <span class="price-now">₨${p.price.toLocaleString()}</span>
        ${p.oldPrice?`<span class="price-old">₨${p.oldPrice.toLocaleString()}</span><span class="price-save">${disc}% off</span>`:''}
      </div>
      <button class="add-cart-btn" onclick="event.stopPropagation();addToCart(${p.id})">
        <i class="fas fa-cart-plus"></i> Add to Cart
      </button>
    </div>
  </div>`;
}

function renderGrid(containerId, items) {
  const el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = items.length ? items.map(renderCard).join('') : '<p style="color:var(--text-light);grid-column:1/-1;text-align:center;padding:40px">No products found.</p>';
}

// ====== INIT HOME ======
function initHome() {
  const sellers = products.filter(p=>['best','hot'].includes((p.badge||'').toLowerCase())).slice(0,5);
  const arrivals = products.filter(p=>p.badge==='New').slice(0,5);
  renderGrid('homeProductGrid', sellers);
  renderGrid('newArrivalsGrid', arrivals);
}

// ====== FILTER CATEGORY ======
const catMeta = {
  'all':{title:'All Products',icon:'🛍️',sub:'Showing all items'},
  'home-decor':{title:'Home Decor',icon:'🛋️',sub:'Transform your living space'},
  'beauty':{title:'Beauty Items',icon:'💄',sub:'Glow up with premium picks'},
  'mobile':{title:'Mobile Accessories',icon:'📱',sub:'Latest gadgets & accessories'},
  'bestseller':{title:'Best Sellers',icon:'⭐',sub:'Our most loved products'},
  'kitchen':{title:'Kitchen Accessories',icon:'🍳',sub:'Cook smarter every day'},
  'clothing':{title:'Clothing',icon:'👕',sub:'Style for every occasion'},
  'footwear':{title:'Footwear',icon:'👟',sub:'Step in comfort & style'},
};

function filterCategory(cat) {
  currentCat = cat;
  priceFilter = 'all';
  sortMode = 'default';
  showPage('category');
  const meta = catMeta[cat]||catMeta['all'];
  document.getElementById('catBreadcrumb').textContent = meta.title;
  document.getElementById('catTitle').textContent = meta.title;
  document.getElementById('catSubtitle').textContent = meta.sub;
  document.getElementById('catIcon').textContent = meta.icon;
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  document.querySelector('.filter-btn').classList.add('active');
  applyFilters();
}

function applyFilters() {
  let items = cat => currentCat==='all'||currentCat==='bestseller'
    ? (currentCat==='bestseller' ? products.filter(p=>['best','hot'].includes((p.badge||'').toLowerCase())) : products)
    : products.filter(p=>p.cat===currentCat);
  let filtered = items();
  if (priceFilter==='low') filtered = filtered.filter(p=>p.price<1500);
  else if (priceFilter==='mid') filtered = filtered.filter(p=>p.price>=1500&&p.price<=5000);
  else if (priceFilter==='high') filtered = filtered.filter(p=>p.price>5000);
  if (sortMode==='low-high') filtered.sort((a,b)=>a.price-b.price);
  else if (sortMode==='high-low') filtered.sort((a,b)=>b.price-a.price);
  else if (sortMode==='rating') filtered.sort((a,b)=>b.rating-a.rating);
  document.getElementById('catSubtitle').textContent = `${filtered.length} products found`;
  renderGrid('catProductGrid', filtered);
}

function filterPrice(mode, btn) {
  priceFilter = mode;
  document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  applyFilters();
}
function sortProducts(val) { sortMode = val; applyFilters(); }

// ====== PAGE NAV ======
function showPage(name) {
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-'+name).classList.add('active');
  window.scrollTo(0,0);
}

// ====== CART ======
function addToCart(id) {
  const p = products.find(x=>x.id===id);
  const ex = cart.find(x=>x.id===id);
  if (ex) ex.qty++;
  else cart.push({...p, qty:1});
  saveCart(); renderCart(); notify('✅ '+p.name.substring(0,30)+'… added to cart!');
}
function saveCart() {
  localStorage.setItem('bm_cart', JSON.stringify(cart));
  document.getElementById('cartCount').textContent = cart.reduce((s,i)=>s+i.qty,0);
}
function renderCart() {
  const el = document.getElementById('cartItems');
  if (!cart.length) {
    el.innerHTML = '<div class="cart-empty"><div><i class="fas fa-shopping-cart"></i></div><p>Your cart is empty</p><small>Add items to get started!</small></div>';
    document.getElementById('cartTotal').textContent = '₨0';
    return;
  }
  el.innerHTML = cart.map(item=>`<div class="cart-item">
    <div class="cart-item-img">${item.emoji}</div>
    <div class="cart-item-info">
      <p class="cart-item-name">${item.name.substring(0,40)}</p>
      <p class="cart-item-price">₨${(item.price*item.qty).toLocaleString()}</p>
      <div class="cart-item-qty">
        <button class="qty-btn" onclick="updateQty(${item.id},-1)">-</button>
        <span>${item.qty}</span>
        <button class="qty-btn" onclick="updateQty(${item.id},1)">+</button>
        <button class="qty-btn" style="color:red" onclick="removeItem(${item.id})"><i class="fas fa-trash"></i></button>
      </div>
    </div>
  </div>`).join('');
  const total = cart.reduce((s,i)=>s+i.price*i.qty,0);
  document.getElementById('cartTotal').textContent = '₨'+total.toLocaleString();
}
function updateQty(id, d) {
  const item = cart.find(x=>x.id===id);
  if (item) { item.qty+=d; if(item.qty<1) cart=cart.filter(x=>x.id!==id); }
  saveCart(); renderCart();
}
function removeItem(id) { cart=cart.filter(x=>x.id!==id); saveCart(); renderCart(); }
function toggleCart() { document.getElementById('cartOverlay').classList.toggle('open'); }
function checkout() { notify('🎉 Proceeding to checkout! (Connect your payment gateway here)'); toggleCart(); }

// ====== MODAL ======
function openModal(id) {
  currentModal = products.find(p=>p.id===id);
  const p = currentModal;
  document.getElementById('modalImg').textContent = p.emoji;
  document.getElementById('modalCat').textContent = p.cat.replace(/-/g,' ');
  document.getElementById('modalName').textContent = p.name;
  document.getElementById('modalRating').textContent = `${p.rating} (${p.reviews} reviews)`;
  document.getElementById('modalPrice').textContent = '₨'+p.price.toLocaleString();
  document.getElementById('modalDesc').textContent = p.desc;
  document.getElementById('modalQty').value = 1;
  document.getElementById('productModal').classList.add('open');
}
function closeModal() { document.getElementById('productModal').classList.remove('open'); }
function changeQty(d) {
  const el = document.getElementById('modalQty');
  el.value = Math.max(1, parseInt(el.value)+d);
}
function addFromModal() {
  if (!currentModal) return;
  const qty = parseInt(document.getElementById('modalQty').value);
  const ex = cart.find(x=>x.id===currentModal.id);
  if (ex) ex.qty+=qty; else cart.push({...currentModal, qty});
  saveCart(); renderCart(); closeModal();
  notify('✅ Added '+qty+' × '+currentModal.name.substring(0,25)+'…');
}

// ====== SEARCH ======
function doSearch() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const cat = document.getElementById('searchCat').value;
  if (!q) return;
  let results = products.filter(p=>p.name.toLowerCase().includes(q)||p.desc.toLowerCase().includes(q));
  if (cat!=='All') results = results.filter(p=>p.cat===cat.toLowerCase().replace(' ','-'));
  currentCat = 'all';
  showPage('category');
  document.getElementById('catTitle').textContent = `Search: "${q}"`;
  document.getElementById('catBreadcrumb').textContent = 'Search Results';
  document.getElementById('catIcon').textContent = '🔍';
  document.getElementById('catSubtitle').textContent = results.length+' results';
  renderGrid('catProductGrid', results);
}
document.getElementById('searchInput').addEventListener('keydown', e=>{ if(e.key==='Enter') doSearch(); });

// ====== WISHLIST ======
function wishItem(btn) {
  const i = btn.querySelector('i');
  if (i.classList.contains('far')) {
    i.classList.replace('far','fas'); btn.style.color='var(--primary)';
    const n = parseInt(document.getElementById('wishCount').textContent)+1;
    document.getElementById('wishCount').textContent = n;
    notify('❤️ Added to Wishlist!');
  } else {
    i.classList.replace('fas','far'); btn.style.color='';
    const n = Math.max(0, parseInt(document.getElementById('wishCount').textContent)-1);
    document.getElementById('wishCount').textContent = n;
  }
}

// ====== NOTIFY ======
function notify(msg) {
  const el = document.getElementById('notification');
  document.getElementById('notifMsg').textContent = msg;
  el.classList.add('show');
  setTimeout(()=>el.classList.remove('show'), 3000);
}

// ====== INIT ======
initHome();
saveCart();
renderCart();
</script>
</body>
</html>